# Copy to .env and fill in before running `docker compose up` from docker/.

# --- LLM ---
# Free-tier key from aistudio.google.com (Get API key > Create API key).
GEMINI_API_KEY=
# Models are PINNED in agent/llm/models.yaml (primary + ordered fallbacks), so model
# changes go through PR review + the eval gate. Leave these blank; they're emergency
# overrides only. Never use "-latest"/"-preview" aliases (they move underneath you).
GEMINI_MODEL=
# Comma-separated fallback list, or "none" to disable fallback.
GEMINI_FALLBACK_MODELS=
# Cost-estimate inputs for the agent-health dashboard; both 0 on the free tier.
GEMINI_PRICE_INPUT_PER_1M_USD=0.0
GEMINI_PRICE_OUTPUT_PER_1M_USD=0.0

# --- GitHub PR automation ---
GITHUB_TOKEN=
GITHUB_REPO=owner/grafana-poc
GITHUB_BASE_BRANCH=main

# --- Grafana ---
# UID of the Prometheus datasource in your Grafana instance (Connections > Data
# sources > Prometheus > the "UID" shown in the URL/settings).
GRAFANA_PROMETHEUS_DS_UID=prometheus

# --- Langfuse (optional; tracing is skipped gracefully if unset) ---
# Region depends on where your Langfuse Cloud project was created:
# EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com
# (the API rejects requests sent to the wrong region's host)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Optional: makes trace deep-links (PR body, dashboard link) without an API lookup.
# Langfuse UI -> Settings -> Project -> Project ID.
LANGFUSE_PROJECT_ID=

# --- PR-outcome tracking (GitHub webhook) ---
# Shared secret for POST /webhooks/github; must match the webhook's "Secret" in
# GitHub -> Settings -> Webhooks. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# "pr" = open a PR adding evals/candidates/<slug>-pr<N>.json when an agent PR is
# edited or closed; "off" = only record the outcome.
EVAL_CANDIDATE_MODE=pr
# Stamped into lineage (PR body + dashboard description). e.g. the deployed git SHA.
AGENT_VERSION=dev
