# Copy to .env and fill in before running `docker compose up` from docker/.

# --- LLM ---
# Free-tier key from aistudio.google.com (Get API key > Create API key).
GEMINI_API_KEY=
# gemini-flash-latest currently aliases to the newest preview model, which has been
# heavily oversubscribed (frequent 503s) on the free tier — gemini-3.5-flash is the
# stable choice tested with this agent.
GEMINI_MODEL=gemini-3.5-flash
# Cost-estimate inputs for the agent-health dashboard; both 0 on the free tier.
GEMINI_PRICE_INPUT_PER_1M_USD=0.0
GEMINI_PRICE_OUTPUT_PER_1M_USD=0.0

# --- GitHub PR automation ---
GITHUB_TOKEN=
GITHUB_REPO=owner/grafana-poc
GITHUB_BASE_BRANCH=main

# --- Grafana ---
# UID of the Prometheus datasource in your Grafana instance (Connections > Data
# sources > Prometheus > the "UID" shown in the URL/settings).
GRAFANA_PROMETHEUS_DS_UID=prometheus

# --- Langfuse (optional; tracing is skipped gracefully if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
