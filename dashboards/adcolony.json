{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "partner-adcolony"
  },
  "spec": {
    "title": "SSP Onboarding - Adcolony",
    "description": "",
    "editable": true,
    "graphTooltip": 0,
    "tags": [
      "partner-onboarding",
      "ssp",
      "adcolony"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Queries per Second",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_requests_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "QPS",
            "refId": "A"
          }
        ],
        "id": 1,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "title": "Request Latency",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(partner_request_duration_seconds_bucket{partner=\"adcolony\"}[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(partner_request_duration_seconds_bucket{partner=\"adcolony\"}[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(partner_request_duration_seconds_bucket{partner=\"adcolony\"}[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "id": 2,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "title": "2XX Success Rate",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_requests_total{partner=\"adcolony\", status_class=\"2xx\"}[5m]))",
            "legendFormat": "2xx",
            "refId": "A"
          }
        ],
        "id": 3,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "title": "5XX Error Rate",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_requests_total{partner=\"adcolony\", status_class=\"5xx\"}[5m]))",
            "legendFormat": "5xx",
            "refId": "A"
          }
        ],
        "id": 4,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "title": "Timeouts",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_timeouts_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "timeouts",
            "refId": "A"
          }
        ],
        "id": 5,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "title": "System Load",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "partner_system_load{partner=\"adcolony\"}",
            "legendFormat": "load",
            "refId": "A"
          }
        ],
        "id": 6,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      },
      {
        "title": "Fill Rate",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_filled_requests_total{partner=\"adcolony\"}[5m])) / sum(rate(partner_ad_requests_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "rate",
            "refId": "A"
          }
        ],
        "id": 7,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        }
      },
      {
        "title": "Revenue RPM",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_revenue_usd_total{partner=\"adcolony\"}[5m])) / sum(rate(partner_impressions_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "rate",
            "refId": "A"
          }
        ],
        "id": 8,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        }
      },
      {
        "title": "Viewability Rate",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_viewable_impressions_total{partner=\"adcolony\"}[5m])) / sum(rate(partner_measured_impressions_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "rate",
            "refId": "A"
          }
        ],
        "id": 9,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 32
        }
      },
      {
        "title": "Render Rate",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_rendered_ads_total{partner=\"adcolony\"}[5m])) / sum(rate(partner_filled_requests_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "rate",
            "refId": "A"
          }
        ],
        "id": 10,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 32
        }
      },
      {
        "title": "Bid Rate by Demand Partner",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum by (demand_partner) (rate(partner_demand_bids_total{partner=\"adcolony\"}[5m])) / sum by (demand_partner) (rate(partner_demand_bid_requests_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "{{demand_partner}}",
            "refId": "A"
          }
        ],
        "id": 11,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 40
        }
      },
      {
        "title": "Timeout Rate by Demand Partner",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum by (demand_partner) (rate(partner_demand_timeouts_total{partner=\"adcolony\"}[5m])) / sum by (demand_partner) (rate(partner_demand_bid_requests_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "{{demand_partner}}",
            "refId": "A"
          }
        ],
        "id": 12,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 40
        }
      },
      {
        "title": "Latency p95 by Demand Partner",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (demand_partner, le) (rate(partner_demand_latency_seconds_bucket{partner=\"adcolony\"}[5m])))",
            "legendFormat": "{{demand_partner}}",
            "refId": "A"
          }
        ],
        "id": 13,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 48
        }
      },
      {
        "title": "Blocked Creatives by Reason",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum by (reason) (rate(partner_blocked_creatives_total{partner=\"adcolony\"}[5m]))",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ],
        "id": 14,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 48
        }
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    }
  }
}