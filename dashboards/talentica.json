{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "partner-talentica"
  },
  "spec": {
    "title": "DSP Onboarding - Talentica",
    "description": "",
    "editable": true,
    "graphTooltip": 0,
    "tags": [
      "partner-onboarding",
      "dsp",
      "talentica"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "5XX Error Rate (alert > 90.0%)",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 90.0
                }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(partner_requests_total{partner=\"talentica\", status_class=\"5xx\"}[5m]))",
            "legendFormat": "5xx",
            "refId": "A"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    }
  }
}