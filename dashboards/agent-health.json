{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "onboarding-agent-health"
  },
  "spec": {
    "title": "Partner Onboarding Agent - Health & Cost",
    "description": "Self-monitoring for the LLM onboarding agent: request volume, latency, and LLM spend.",
    "editable": true,
    "graphTooltip": 0,
    "tags": ["partner-onboarding", "llmops"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "templating": { "list": [] },
    "annotations": { "list": [] },
    "panels": [
      {
        "id": 1,
        "title": "Onboarding Requests by Result",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
        "targets": [
          {
            "expr": "sum(rate(agent_onboard_requests_total[5m])) by (result)",
            "legendFormat": "{{result}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Onboarding Duration (p95)",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(agent_onboard_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "LLM Call Duration (p95)",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(agent_llm_call_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "LLM Tokens by Direction",
        "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
        "targets": [
          {
            "expr": "sum(rate(agent_llm_tokens_total[5m])) by (direction)",
            "legendFormat": "{{direction}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Cumulative LLM Cost",
        "type": "stat",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
        "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
        "targets": [
          {
            "expr": "agent_llm_cost_usd_total",
            "legendFormat": "cost",
            "refId": "A"
          }
        ]
      }
    ]
  }
}
